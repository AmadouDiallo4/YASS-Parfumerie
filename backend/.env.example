NODE_ENV=development
PORT=4000
DATABASE_URL="******HOST:3306/DATABASE"
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="1d"
CORS_ORIGIN="http://localhost:3000"
UPLOAD_BASE_URL=""
ADMIN_EMAIL="admin@yassparfums.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_NAME="Administrateur YASS"
# Force Prisma to use the OpenSSL 3 binary engine (required on Hostinger)
PRISMA_QUERY_ENGINE_BINARY=node_modules/.prisma/client/query-engine-debian-openssl-3.0.x
